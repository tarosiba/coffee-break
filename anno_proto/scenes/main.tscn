[node name="PopulationLabel" type="Label" parent="UI/Panel/MarginContainer/VBox"]
text = "👥 人口 0　🍞 パン供給率 —"
autowrap_mode = 2

[node name="BtnHouse" type="Button" parent="UI/Panel/MarginContainer/VBox"]
