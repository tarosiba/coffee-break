[node name="BtnWheat" type="Button" parent="UI/Panel/MarginContainer/VBox"]
text = "🌾 小麦畑"

[node name="BtnPlowed" type="Button" parent="UI/Panel/MarginContainer/VBox"]
text = "🚜 耕起畑"

[node name="BtnWindmill" type="Button" parent="UI/Panel/MarginContainer/VBox"]
text = "🌀 風車"

[node name="BtnBakery" type="Button" parent="UI/Panel/MarginContainer/VBox"]
